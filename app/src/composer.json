{
    "name": "aizberg/aizberg",
    "type": "project",
    "description": "Aizberg — платформа для интернет-магазинов: API и бэкенд.",
    "keywords": ["aizberg", "e-commerce", "shop", "cms", "laravel"],
    "license": "GPL-3.0-only",
    "require": {
        "php": "^8.0",
        "aws/aws-sdk-php": "*",
        "bonecms/laravel-captcha": "^2.2",
        "fideloper/proxy": "^4.4",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "jenssegers/agent": "^2.6",
        "laravel-lang/lang": "~8.0",
        "laravel/framework": "^8.12",
        "laravel/tinker": "^2.5",
        "mpdf/mpdf": "^8.1",
        "nwidart/laravel-modules": "^v8.3.0",
        "opcodesio/log-viewer": "^3.10",
        "shuchkin/simplexlsx": "*",
        "shuchkin/simplexlsxgen": "*"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.5",
        "barryvdh/laravel-ide-helper": "^2.10",
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "friendsofphp/php-cs-fixer": "v2.18.5",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^5.0",
        "phpmd/phpmd": "^2.9.1",
        "phpstan/phpstan": "^0.12.83",
        "phpunit/phpunit": "^9.3.3",
        "squizlabs/php_codesniffer": "^3.6.0",
        "vimeo/psalm": "^4.7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "Modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "platform-check": false,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
