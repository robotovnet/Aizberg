APP_NAME=Aizberg
APP_URL=https://domain

APP_ENV=dev
APP_DEBUG=false

BASIC_AUTH_ENABLED=RestrictedArea # RestrictedArea|off

DB_DATABASE=aizberg
DB_USERNAME=aizberg_user
DB_PASSWORD=pwd
DB_ROOT_PASSWORD=root_pwd

WEBSERVER_PORT=80
WEBSERVER_PORT_SSL=443
CP_PORT=8443
ADMINER_PORT=81

WEBSERVER_HOST=domain
SHOP_HOSTS="city1.domain city2.domain"
API_HOST=api.domain
SESSION_DOMAIN=.domain
REDIRECT_HOST=redirect_domain

# Storefront (public site) settings used to build links in API responses, see app/src/config/storefront.php
# Leave STOREFRONT_URL empty to use the host of the current request.
STOREFRONT_URL=
STOREFRONT_PREFIX_URL=
STOREFRONT_PRODUCT_URL_PATTERN="item/{slug}_{id}.html"
STOREFRONT_DEFAULT_CITY="Москва"
STOREFRONT_PHONE_NUMBER=

HOST_USER_ID  = 1000
HOST_GROUP_ID = 1000

CATALOG_MICRO_PHOTO_WIDTH=240
CATALOG_MICRO_PHOTO_HEIGHT=240
CATALOG_MINI_PHOTO_WIDTH=1060
CATALOG_MINI_PHOTO_HEIGHT=1060

MAILGUN_DOMAIN="domain"
MAILGUN_SECRET="secret"

MAIL_FROM="no-reply@domain"
MAIL_REPLY_TO="manager@domain"

YANDEX_CLOUD_POSTBOX_KEY="key"
YANDEX_CLOUD_POSTBOX_SECRET="secret"

RUSENDER_API_KEY="key"

PRONTOSMS_USER="user"
PRONTOSMS_SENDER="sender"
PRONTOSMS_PWD="password"

# Yandex Wordstat (xmlriver.com)
XMLRIVER_USER_ID="xmlriver_user_id"
XMLRIVER_API_KEY="xmlriver_api_key"
